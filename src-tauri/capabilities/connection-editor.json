{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "connection-editor",
  "description": "Connection editor window: profile list/save, SSH host lookup and closing itself. No events, no window control.",
  "windows": [
    "connection-editor"
  ],
  "permissions": [
    "allow-connections-list",
    "allow-connection-save",
    "allow-ssh-hosts-list",
    "allow-ssh-host-resolve",
    "allow-connection-editor-close"
  ]
}
